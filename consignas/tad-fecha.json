      "referencia": "#include <stdio.h>\n#include \"fecha.h\"\n\nint main() {\n  int dia, mes, anio, n;\n  TFecha f;\n\n  scanf(\"%d\", &dia);\n  scanf(\"%d\", &mes);\n  scanf(\"%d\", &anio);\n  scanf(\"%d\", &n);\n  f = crear(dia, mes, anio);\n  f = sumarDias(f, n);\n  mostrar(f);\n  return 0;\n}"
    }
